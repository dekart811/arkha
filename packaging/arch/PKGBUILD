# Maintainer: dekart811 <mail@dekart811.net>
#
# Builds Arkha from this repository's committed state (uncommitted changes
# aren't included): cd packaging/arch && makepkg -si

pkgname=arkha
pkgver=0.1.0
pkgrel=1
pkgdesc='A fast graphical file manager'
arch=('x86_64' 'aarch64')
url='https://github.com/dekart811/arkha'
license=('GPL-3.0-or-later')
depends=(
  'at-spi2-core'
  'cairo'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'gvfs'
  'hicolor-icon-theme'
  'libgcc'
  'pango'
)
makedepends=('cargo' 'git' 'gettext')
optdepends=(
  'bubblewrap: thumbnailers in a sandbox (recommended)'
  'ffmpegthumbnailer: video thumbnails'
  'ffmpeg: video thumbnails without ffmpegthumbnailer'
  'mediainfo: the Media Info tab in Properties'
  'gvfs-mtp: phones and media players over MTP'
  'gvfs-gphoto2: cameras'
  'gvfs-smb: Windows and Samba network shares'
  'engrampa: creating and extracting archives'
  'file-roller: creating and extracting archives'
  'xarchiver: creating and extracting archives'
  'ark: creating and extracting archives'
  'xterm: Open in Terminal, if no other terminal is installed'
)
# Cargo strips the program: there's nothing for a -debug package (which
# makepkg makes where its settings have "debug", as Arch's do by default).
options=('!debug')
source=("$pkgname::git+file://$(realpath ../..)")
sha256sums=('SKIP')

# Cargo.toml's version as pacman sorts it: a build towards 1.0.0 ("1.0.0-dev"
# there) is 1.0.0dev.r<commits>.g<commit>, older than 1.0.0; the release
# (tagged v1.0.0) is 1.0.0; a build after it 1.0.0.r<commits>.g<commit>.
pkgver() {
  cd "$pkgname"
  local version base pre
  version="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)"
  base="${version%%-*}"
  pre="${version#"$base"}"
  pre="${pre#-}"
  if [ -z "$pre" ] && git describe --exact-match --tags --match "v$version" >/dev/null 2>&1; then
    printf '%s' "$base"
  else
    printf '%s%s.r%s.g%s' "$base" "$pre" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  fi
}

prepare() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --release
}

package() {
  cd "$pkgname"
  install -Dm755 target/release/arkha "$pkgdir/usr/bin/arkha"
  install -Dm644 arkha.desktop "$pkgdir/usr/share/applications/arkha.desktop"
  install -Dm644 data/arkha.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/arkha.svg"
  install -Dm644 data/io.github.dekart811.Arkha.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.dekart811.Arkha.metainfo.xml"
  # The translations build.rs made from po/*.po.
  for mo in target/release/locale/*/LC_MESSAGES/arkha.mo; do
    install -Dm644 "$mo" "$pkgdir/usr/share/locale/${mo#target/release/locale/}"
  done
  # The manual's pages build.rs made from docs/manual.
  # Never a package without them (the loop below would pass without any).
  test -f target/release/manual/en/index.html
  find target/release/manual -type f | while read -r f; do
    install -Dm644 "$f" "$pkgdir/usr/share/arkha/${f#target/release/}"
  done
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
